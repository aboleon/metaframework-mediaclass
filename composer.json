{
  "name": "aboleon/metaframework-mediaclass",
  "description": "Mediaclass media management components for MetaFramework",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "aboleon/metaframework-inputable": "^1.0",
    "aboleon/metaframework-support": "^1.0",
    "css-crush/css-crush": "^v5.0.0",
    "intervention/image": "^3.11",
    "illuminate/cache": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/filesystem": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/view": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "cohensive/oembed": "^0.20.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0|^12.0",
    "orchestra/testbench": "^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "MetaFramework\\Mediaclass\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "MetaFramework\\Mediaclass\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
  },
  "extra": {
    "laravel": {
      "providers": [
        "MetaFramework\\Mediaclass\\MediaclassServiceProvider"
      ],
      "aliases": {
        "Mediaclass": "MetaFramework\\Mediaclass\\Facades\\MediaclassFacade"
      }
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
