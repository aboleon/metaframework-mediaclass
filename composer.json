{
  "name": "aboleon/metaframework-mediaclass",
  "description": "Mediaclass media management components for MetaFramework",
  "version": "0.1.0",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/filesystem": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0",
    "illuminate/view": "^11.0|^12.0",
    "illuminate/database": "^11.0|^12.0",
    "aboleon/metaframework-support": "^0.1",
    "aboleon/metaframework-inputable": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "MetaFramework\\Mediaclass\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "MetaFramework\\Mediaclass\\MediaclassServiceProvider"
      ],
      "aliases": {
        "Mediaclass": "MetaFramework\\Mediaclass\\Facades\\MediaclassFacade"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../_packages/aboleon/*"
    }
  ]
}
