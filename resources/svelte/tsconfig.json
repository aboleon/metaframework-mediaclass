{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "moduleResolution": "bundler",
    "strict": true,
    "target": "ES2020",
    "types": ["jquery", "svelte"]
  },
  "include": [
    "*.d.ts",
    "*.ts",
    "*.svelte"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
